# The Oracle — Azure Foundry Configuration
# Copy to .env and fill in values

# Azure AI Foundry (Responses API) — authenticates with Microsoft Entra ID
# (DefaultAzureCredential: `az login`, managed identity, etc.). No key needed.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
# Optional fallback only if Entra ID is unavailable. Never commit a real key.
# AZURE_OPENAI_API_KEY=

# Reliability
ORACLE_VERIFICATION=live          # live | off
ORACLE_ABSTAIN=true               # abstain when evidence is weak/uncited
ORACLE_ABSTAIN_THRESHOLD=0.35
ORACLE_LLM_TIMEOUT=120
CORS_ORIGINS=http://localhost:8001

# Database
ORACLE_DB=sqlite:///oracle.db

# Server
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8001
